# ============================================================================
# Itinera backend — environment variables template
# ============================================================================
# Copy to `.env` and fill the values. NEVER commit the real `.env`.
# ----------------------------------------------------------------------------

# HTTP port (default: 8080)
API_PORT=8080

# PostgreSQL connection (compose dev defaults)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/itinera?sslmode=disable

# JWT signing key. MUST be >= 32 chars in production.
JWT_SECRET=dev-secret-change-me

# Allowed values: development | staging | production
ENVIRONMENT=development

# Public origin used for shareable URLs and CORS.
PUBLIC_ORIGIN=https://goitinera.app

# Internal token for /api/analytics/*. MUST be >= 32 chars in production.
ITINERA_INTERNAL_TOKEN=

# ----------------------------------------------------------------------------
# Auth v2 cutover (Spec 017 §2.1). Default false; flip to true in production
# AFTER the dual-stack window has been monitored for at least one week.
# ----------------------------------------------------------------------------
AUTH_V2_ENABLED=false

# Resend API key for transactional email. Required in production once
# AUTH_V2_ENABLED=true (validated by Config.Validate).
RESEND_API_KEY=

# From: header used on outgoing emails. Defaults to mail.itinera.app but you
# can override in dev with e.g. "Itinera Dev <noreply@mail.itinera.app>".
EMAIL_FROM=Itinera <hello@mail.itinera.app>