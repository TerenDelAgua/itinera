# ============================================================================
# Itinera backend — LOCAL DEVELOPMENT (docker-compose Postgres)
# ============================================================================
# This file is read by `.dev.sh` / `.dev.ps1` wrappers and points at the
# docker-compose Postgres on localhost:5432. The .env file in the same
# folder is reserved for production (Supabase); do NOT delete it.
#
# In the .gitignore alongside this file (we'll add it next).
# ----------------------------------------------------------------------------

# Local docker-compose Postgres (created in docker-compose.yaml with
# POSTGRES_USER=postgres, POSTGRES_PASSWORD=postgres, POSTGRES_DB=itinera).
# DSN format — special characters in passwords are safe here.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=itinera
DB_SSLMODE=disable

API_PORT=8080

# Local dev secrets (NEVER use these in production).
JWT_SECRET=dev-secret-change-me-not-for-prod
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:3000

# No internal token needed in dev (the middleware path is only exercised
# in CI). Leave it empty — Config.Validate() won't complain in dev.
ITINERA_INTERNAL_TOKEN=

# Auth v2 cutover: ON in dev so we smoke-test the new tree.
AUTH_V2_ENABLED=true

# Email: in development, the EmailSender is NoopSender (no real Resend
# call). Leave RESEND_API_KEY empty.
RESEND_API_KEY=
EMAIL_FROM=Itinera Dev <noreply@mail.itinera.app>